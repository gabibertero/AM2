---
import 'katex/dist/katex.min.css';
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-500.css';
import '@fontsource/instrument-sans/latin-600.css';
import '@fontsource/instrument-sans/latin-700.css';
import '@fontsource/stix-two-text/latin-600.css';
import '@fontsource/stix-two-text/latin-700.css';
import '../styles/global.css';

const { titulo } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  ['Inicio', base],
  ['Parciales oficiales', `${base}parciales/`],
  ['Años anteriores', `${base}anteriores/`],
  ['Teoría', `${base}teoria/`],
  ['Machetes', `${base}machetes/`],
  ['Simulacros generados', `${base}generados/`],
];
const actual = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · AM II</title>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="sitio">
      <div class="sitio-in">
        <a class="marca" href={base}><span aria-hidden="true">∬</span> AM II <span class="marca-sub">· 2º parcial</span></a>
        <nav aria-label="Principal">
          <ul>
            {nav.map(([texto, href]) => (
              <li><a href={href} aria-current={(href === base ? actual === href : actual.startsWith(href)) ? 'page' : undefined}>{texto}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="pie">
      <p>AM II · 2º parcial · UTN FRC. Material de estudio no oficial. <a href="https://github.com/gabibertero/AM2">Código en GitHub</a></p>
    </footer>
    <script>
      import '../scripts/progreso.js';
      import '../ui.js';
    </script>
  </body>
</html>
