---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

const { titulo } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  ['Inicio', base],
  ['Parciales oficiales', `${base}parciales/`],
  ['Teoría', `${base}teoria/`],
  ['Machetes', `${base}machetes/`],
  ['Simulacros generados', `${base}generados/`],
];
const actual = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · AM II</title>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="sitio">
      <nav aria-label="Principal">
        <ul>
          {nav.map(([texto, href]) => (
            <li><a href={href} aria-current={actual === href ? 'page' : undefined}>{texto}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="contenido"><slot /></main>
    <script>
      import '../scripts/progreso.js';
    </script>
  </body>
</html>
