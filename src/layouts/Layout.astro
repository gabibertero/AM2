---
import 'katex/dist/katex.min.css';
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-500.css';
import '@fontsource/instrument-sans/latin-600.css';
import '@fontsource/instrument-sans/latin-700.css';
import '@fontsource/stix-two-text/latin-600.css';
import '@fontsource/stix-two-text/latin-700.css';
import '../styles/global.css';
import '../styles/preparacion.css';
import '../styles/guiado.css';
const { titulo } = Astro.props;
const base = import.meta.env.BASE_URL;
const actual = Astro.url.pathname;
const nav = [['Hoy',base,'◷'],['Parciales',`${base}parciales/`,'▤'],['Laboratorio',`${base}laboratorio/`,'⚗'],['Machetes',`${base}machetes/`,'≋'],['Mis errores',`${base}errores/`,'↺']];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#152c38" />
<meta name="description" content="Prepará el práctico de AM II con parciales reales, machetes en pasos cortos y simulacros de dos horas." />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<title>{titulo} · AM II</title>
</head>
<body>
<a class="saltar" href="#contenido">Saltar al contenido</a>
<header class="sitio">
 <div class="sitio-in">
  <a class="marca" href={base}><span class="marca-simbolo" aria-hidden="true">∫∫</span><span>AM II<small>Tu espacio de práctica</small></span></a>
  <p class="nav-label">PREPARACIÓN</p>
  <nav aria-label="Principal"><ul>{nav.map(([texto,href,ico])=><li><a href={href} aria-current={(href===base?actual===href:actual.startsWith(href))?'page':undefined}><span class="nav-ico" aria-hidden="true">{ico}</span>{texto}</a></li>)}</ul></nav>
  <div class="nav-examen"><span class="status-dot"></span><p>Próximo objetivo<strong>Sábado 7 de noviembre</strong><small>Práctico · 120 minutos</small></p></div>
  <p class="nav-bottom">UTN FRC · Mazzuchelli<br />Aprendé. Intentá. Volvé a probar.</p>
 </div>
</header>
<main id="contenido"><div class="topline"><span>ANÁLISIS MATEMÁTICO II</span><span>2º parcial práctico <i aria-hidden="true">●</i></span></div><slot /></main>
<footer class="pie"><p>Hecho para practicar, paso a paso. Enunciados oficiales · ayudas de estudio no oficiales.</p><details><summary>Más material y opciones</summary><p><a href={`${base}anteriores/`}>Otros años</a> · <a href={`${base}laboratorio/`}>Práctica adicional</a> · <a href="https://github.com/gabibertero/AM2">Repositorio</a></p><p>El progreso se guarda en este navegador. Actualizar el sitio lo conserva.</p><button type="button" data-reiniciar>Reiniciar progreso</button><div data-confirmar hidden><p>¿Borrar el progreso de este navegador?</p><button type="button" data-si>Sí, borrar todo</button><button type="button" data-no>Cancelar</button></div></details><p role="status" data-resultado></p></footer>
<script>
import '../scripts/progreso.js'; import '../ui.js'; import '../scripts/ia.js'; import '../scripts/ultimo.js'; import '../scripts/examen.js'; import '../scripts/estudio.js';
</script>
<noscript><style is:inline>[data-dia], [data-reiniciar]{display:none!important}[data-plan-dia][hidden]{display:block!important}</style></noscript>
</body>
</html>
