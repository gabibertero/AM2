---
interface Props {
  id: string;
  numero: number | string;
  fuente: string;
  pagina: number | string;
  unidad: string;
  tema: string;
  machete?: string;
}
const { id, numero, fuente, pagina, unidad, tema, machete } = Astro.props;
import IA from './IA.astro';
import { getCollection } from 'astro:content';
import { controlesGuiados } from '../lib/controles-guiados.js';
const guiado = controlesGuiados.has(id);
const archivo = fuente.split('/').pop().replace(/\.[a-z]+$/i, '');
const ayudas = `ayudas-${id.replace(/\W/g, '-')}`;
const base = import.meta.env.BASE_URL;
// El chip enlaza al machete concreto (por título o slug); si no se encuentra, al índice.
const m = machete ? (await getCollection('machetes')).find((e) => e.data.slug === machete || e.data.titulo === machete) : null;
const hrefMachete = `${base}machetes/${m ? m.data.slug + '/' : ''}`;
const estados = [['pendiente', 'Pendiente'], ['en-curso', 'En curso'], ['resuelto', 'Resuelto']];
---
<section class="ejercicio" id={`ej-${numero}`} data-ejercicio data-id={id} data-unidad={unidad} data-ia-ctx>
  <header class="ej-cab">
    <span class="ej-num" aria-hidden="true">{numero}</span>
    <div>
      <h2>Ejercicio {numero}</h2>
      <p class="meta">
        <span class="chip chip-u" data-unidad={unidad}>{unidad}</span>
        <span class="chip" data-ia-tit>{tema}</span>
        <span class="ej-fuente">{archivo}, p.{pagina}</span>
        {guiado && <a class="chip chip-link" href={`${base}laboratorio/?parcial=${id.split('#')[0]}&ejercicio=${numero}`}>Resolver en laboratorio →</a>}
        {machete && <a class="chip chip-link" href={hrefMachete}>Machete: {m ? m.data.titulo : machete}</a>}
      </p>
    </div>
  </header>
  <fieldset class="estado" data-js hidden>
    <legend>Estado</legend>
    <span class="seg">
    {estados.map(([valor, texto]) => (
      <label><input type="radio" name={`estado-${id}`} value={valor} checked={valor === 'pendiente'} />{texto}</label>
    ))}
    </span>
  </fieldset>
  <div id={ayudas} aria-live="polite"><slot /></div>
  <div class="acciones" data-js hidden>
    <button type="button" data-accion="pista" aria-expanded="false" aria-controls={ayudas}>Ver pista</button>
    <button type="button" data-accion="paso" aria-expanded="false" aria-controls={ayudas}>Explicame paso a paso</button>
    <button type="button" data-accion="solucion" aria-expanded="false" aria-controls={ayudas}>Ver solución completa</button>
    <button type="button" data-accion="ocultar">Ocultar todo</button>
  </div>
  <div class="aprendizaje" data-aprendizaje hidden>
    <h3>¿Cómo te salió este intento?</h3>
    <p>Seguir una solución es el primer paso. Resolverla sin mirar es el siguiente.</p>
    <div class="autonomia-botones" role="group" aria-label={`Autonomía del ejercicio ${numero}`}>
      <button type="button" data-autonomia="ayuda" aria-pressed="false">Lo seguí con ayuda</button>
      <button type="button" data-autonomia="repetir" aria-pressed="false">Necesito repetirlo</button>
      <button type="button" data-autonomia="solo" aria-pressed="false">Lo hice solo</button>
    </div>
    <label>¿En qué paso te trabaste? <textarea maxlength="1200" placeholder="Ej.: no sabía de dónde salía el límite de r." aria-label={`Mi dificultad en el ejercicio ${numero}`}></textarea></label>
    <p role="status" data-aprendizaje-status></p>
  </div>
  <IA modo="corregir" numero={numero} />
  <div class="autocorr" data-autocorr hidden role="group" aria-label={`Autocorrección del ejercicio ${numero}`}>
    <p class="autocorr-t">Autocorrección</p>
    <div class="autocorr-b">
      <button type="button" data-nota="1" aria-pressed="false">Bien</button>
      <button type="button" data-nota="0.5" aria-pressed="false">A medias</button>
      <button type="button" data-nota="0" aria-pressed="false">Mal</button>
    </div>
  </div>
</section>
<script>
  import '../scripts/figuras.js';
  // Sin JS las ayudas se ven (noscript) y estos controles quedan ocultos.
  document.querySelectorAll('.ejercicio [data-js]').forEach((e) => (e.hidden = false));
</script>
<noscript><style is:inline>.ejercicio .capa[hidden]{display:block!important}</style></noscript>
