---
import { limpiarFuente } from '../lib/fuente.js';
const { fuente, pagina, examen } = Astro.props;
const src = examen && `${import.meta.env.BASE_URL}escaneos/${examen}/p${pagina}.webp`;
---
<div class="capa oficial" data-ia-enun>
  <p class="rotulo">Enunciado oficial — tal cual la fuente</p>
  <slot />
  <p class="cita">Fuente: {limpiarFuente(fuente.split('/').pop())}, p.{pagina}</p>
  {examen && (
    <details>
      <summary>Ver enunciado original escaneado (p.{pagina})</summary>
      <div class="scan" tabindex="0" role="region" aria-label="Escaneo del enunciado, desplazable">
      <img src={src} alt={`Enunciado original escaneado, página ${pagina}`} loading="lazy" width="1400" height="1980" style="max-width:100%;height:auto" />
      </div>
      <p><a href={src} target="_blank" rel="noopener">abrir en tamaño completo</a></p>
    </details>
  )}
</div>
