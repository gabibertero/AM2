---
// Mapa de una instancia: una tarjeta por unidad con lo que cayó en los parciales prácticos y accesos.
// Las unidades con cae='proximamente' (sin contenido todavía) no linkean a nada.
import { UNIDADES, CAE, instanciaDeUnidad } from '../lib/sitio.js';
const { temas, instancia } = Astro.props; // { U4: [[tema, veces], ...], ... } calculado en el index desde los parciales
const base = import.meta.env.BASE_URL;
---
<ol class="mapa">
  {UNIDADES.filter((x) => instanciaDeUnidad(x.u) === instancia).map(({ u, titulo, cae, slug }) => (
    <li class="mapa-u" data-unidad={u} data-cae={cae}>
      <header>
        <span class="mapa-n">{u}</span>
        <span class="mapa-cae">{CAE[cae]}</span>
      </header>
      <h3>{titulo}</h3>
      {cae === 'proximamente' ? (
        <p class="suave mapa-vacio">Próximamente: estamos preparando el material.</p>
      ) : temas[u]?.length > 0 ? (
        <ul class="mapa-temas">
          {temas[u].map(([t, n]) => <li>{t}<span class="suave"> · {n}×</span></li>)}
        </ul>
      ) : (
        <p class="suave mapa-vacio">{cae === 'sin-material' ? 'Pendiente: todavía no hay material.' : 'No apareció en parciales prácticos.'}</p>
      )}
      {cae !== 'proximamente' && <nav class="mapa-acc" aria-label={`Accesos de ${u}`}>
        <a href={`${base}teoria/${slug}/`}>Teoría</a>
        {cae === 'practico' && <a href={`${base}parciales/`}>Ejercicios</a>}
        {cae === 'practico' && <a href={`${base}machetes/`}>Machetes</a>}
        <a href={`${base}preguntero/#h-${u}`}>Preguntero</a>
      </nav>}
    </li>
  ))}
</ol>
<style>
  .mapa { max-width: none; list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  @media (min-width: 1100px) { .mapa:has(> :nth-child(7)) { grid-template-columns: repeat(4, 1fr); } } /* 7 unidades: 4+3, sin huérfana */
  .mapa-u { background: var(--sup); border: 1px solid var(--borde); border-top: 4px solid var(--uc); border-radius: var(--r); padding: var(--s-24); box-shadow: var(--sombra); display: flex; flex-direction: column; gap: 8px; }
  .mapa-u header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-8); }
  .mapa-n { white-space: nowrap; font-family: var(--f-ed); font-weight: 700; font-size: 1.75rem; line-height: 1; color: var(--uc); }
  .mapa-cae { font-size: .8125rem; font-weight: 600; color: var(--suave); border: 1px solid var(--borde); border-radius: 999px; padding: 0 var(--s-12); background: var(--sup2); white-space: nowrap; }
  [data-cae='practico'] .mapa-cae { color: var(--e-ok); background: var(--e-ok-bg); border-color: color-mix(in srgb, var(--e-ok) 40%, var(--sup)); }
  [data-cae='tentativo'] .mapa-cae { color: var(--e-curso); background: var(--e-curso-bg); border-color: color-mix(in srgb, var(--e-curso) 40%, var(--sup)); }
  .mapa-u h3 { margin: 0; font-size: 1.125rem; text-wrap: balance; }
  .mapa-temas { margin: 0; padding-left: 16px; font-size: .9375rem; flex: 1; }
  .mapa-vacio { margin: 0; font-size: .9375rem; flex: 1; }
  .mapa-acc { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 var(--s-8); margin-top: auto; padding-top: var(--s-8); border-top: 1px dashed var(--borde); }
  .mapa-acc a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; font-size: .9375rem; white-space: nowrap; }
</style>
