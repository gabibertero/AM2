---
import IA from './IA.astro';
import { limpiarFuente } from '../lib/fuente.js';
import { letra } from '../scripts/preguntero-logica.js';
// Una pregunta del preguntero. Slots (MDX con KaTeX):
//   enunciado (obligatorio) · guia (solo tema: lista de "qué tiene que tener") · opciones (solo choice: lista numerada)
//   default = respuesta modelo (tema/corta) o "por qué" (choice).
// fq / fr = fuente de la pregunta / de la respuesta, texto libre "archivo, p. N". aparecio = "Modelo P2 · T1" o vacío (pregunta de práctica).
const { id, unidad, tipo, titulo, aparecio = '', fq = '', fr = '', correcta, borrador = false } = Astro.props;
if (!['tema', 'corta', 'choice'].includes(tipo)) throw new Error(`Pregunta ${id}: tipo inválido "${tipo}"`);
if (tipo === 'choice' && !(Number(correcta) >= 1)) throw new Error(`Pregunta ${id}: choice sin correcta (número de opción desde 1)`);
const ETIQ = { tema: 'tema a desarrollar', corta: 'pregunta corta', choice: 'multiple choice' };
const tieneGuia = Astro.slots.has('guia');
---
<article class="preg" data-pregunta data-id={id} data-unidad={unidad} data-tipo={tipo} data-correcta={tipo === 'choice' ? correcta : undefined} id={id} data-ia-ctx>
  <header class="preg-cab">
    <span class="chip chip-u">{unidad}</span>
    <span class="chip">{ETIQ[tipo]}</span>
    {aparecio ? <span class="chip chip-fuerte" title="Apareció en un parcial">cayó en {aparecio}</span> : <span class="chip">pregunta de práctica</span>}
    {borrador && <span class="chip chip-borrador">borrador</span>}
    <span class="preg-estado" data-estado-txt aria-live="polite"></span>
  </header>
  <h3 class="preg-tit" data-ia-tit>{titulo}</h3>
  <blockquote class="preg-enun" data-ia-enun><Fragment><slot name="enunciado" /></Fragment></blockquote>
  {tieneGuia && <div class="preg-guia"><p class="preg-guia-t">Qué tiene que tener la respuesta</p><slot name="guia" /></div>}
  {tipo === 'choice' && <div class="preg-ops" data-ops><slot name="opciones" /></div>}
  {tipo === 'choice' && <p class="preg-fb" data-fb role="status"></p>}
  {fq && <p class="preg-fte">Pregunta: <em>{limpiarFuente(fq)}</em></p>}
  {tipo === 'choice' ? <IA modo="explicar" /> : <IA modo="corregir" />}
  <details class="preg-resp" data-resp>
    <summary><span class="s-ver">{tipo === 'choice' ? 'Mostrar la correcta y por qué' : 'Mostrar respuesta modelo'}</span><span class="s-ocultar">Ocultar respuesta</span></summary>
    <div class="resp lectura-resp" data-ia-modelo>
      {tipo === 'choice' && <p><strong>Opción correcta: {letra(Number(correcta))})</strong></p>}
      <slot />
    </div>
    {fr && <p class="preg-fte">Respuesta elaborada a partir de: <em>{limpiarFuente(fr)}</em></p>}
  </details>
  <div class="preg-acc" role="group" aria-label="Marcar pregunta" data-js hidden>
    <button type="button" class="btn-sabe" data-marca="sabe" aria-pressed="false">✓ La sé</button>
    <button type="button" class="btn-dudosa" data-marca="dudosa" aria-pressed="false">? Dudosa</button>
    <button type="button" class="btn-nose" data-marca="nose" aria-pressed="false">✗ No la sé</button>
  </div>
</article>
<style is:global>
  .preg { background: var(--sup); border: 1px solid var(--borde); border-top: 5px solid var(--uc, var(--borde-fuerte)); border-radius: var(--r); box-shadow: var(--sombra); padding: 16px 20px 14px; margin: 0 0 1.25rem; min-width: 0; }
  .preg[data-estado='sabe'] { border-top-color: var(--e-ok); }
  .preg[data-estado='dudosa'] { border-top-color: var(--generado); }
  .preg[data-estado='nose'] { border-top-color: var(--pendiente); }
  .preg-cab { display: flex; flex-wrap: wrap; align-items: center; gap: 0; }
  .chip-borrador { color: var(--generado); background: var(--generado-fondo); border-color: var(--generado); }
  .preg-estado { margin-left: auto; font-size: .8125rem; font-weight: 700; color: var(--suave); }
  .preg[data-estado='sabe'] .preg-estado { color: var(--e-ok); }
  .preg[data-estado='dudosa'] .preg-estado { color: var(--generado); }
  .preg[data-estado='nose'] .preg-estado { color: var(--pendiente); }
  .preg-tit { margin: var(--s-8) 0; font-size: 1.2rem; }
  .preg-enun { margin: 0 0 .6rem; padding: 4px 14px; border-left: 4px solid var(--uc, var(--borde-fuerte)); background: var(--sup2); border-radius: 0 var(--r-s) var(--r-s) 0; overflow-x: auto; position: relative; }
  .preg-enun > :first-child { margin-top: .4em; } .preg-enun > :last-child { margin-bottom: .4em; }
  .preg-guia { margin: .6rem 0; padding: 4px 14px; border: 1px dashed var(--borde-fuerte); border-radius: var(--r-s); overflow-x: auto; position: relative; }
  .preg-guia-t { margin: .4rem 0 0; font-size: .8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; color: var(--suave); }
  .preg-guia ul { margin: .3rem 0 .5rem; padding-left: 1.2rem; }
  .preg-fte { margin: var(--s-8) 0 0; font-size: .8125rem; color: var(--suave); overflow-wrap: anywhere; }
  .preg-ops { overflow-x: auto; position: relative; margin: .5rem 0; }
  .preg-ops ol { margin: 0; padding-left: 1.6rem; list-style: lower-alpha; }
  .preg-ops ol.op-lista { padding: 0; list-style: none; display: grid; gap: 8px; }
  .op { display: flex; align-items: flex-start; gap: var(--s-12); padding: var(--s-8) var(--s-12); border: 1px solid var(--borde-fuerte); border-radius: var(--r-s); background: var(--sup2); cursor: pointer; min-height: 44px; }
  .op:has(input:checked) { border-color: var(--acento); box-shadow: inset 0 0 0 1px var(--acento); }
  .op:has(input:focus-visible) { outline: 3px solid var(--link); outline-offset: 2px; }
  .op input { width: 24px; height: 24px; margin: 0; accent-color: var(--acento); flex: none; }
  .op-t { min-width: 0; overflow-wrap: anywhere; }
  .op[data-res='ok'] { border-color: var(--e-ok); background: var(--e-ok-bg); box-shadow: inset 0 0 0 1px var(--e-ok); }
  .op[data-res='mal'] { border-color: var(--pendiente); box-shadow: inset 0 0 0 1px var(--pendiente); }
  .preg-fb { margin: .3rem 0; font-weight: 700; }
  .preg-fb:empty { display: none; }
  .preg-resp { margin: .6rem 0 .4rem; }
  .preg-resp > summary { cursor: pointer; font-weight: 700; min-height: 44px; display: inline-flex; align-items: center; padding: 4px 14px; border: 1px solid var(--acento); border-radius: 999px; color: var(--acento); list-style: none; }
  .preg-resp > summary::-webkit-details-marker { display: none; }
  .preg-resp .s-ocultar, .preg-resp[open] .s-ver { display: none; }
  .preg-resp[open] .s-ocultar { display: inline; }
  .resp { margin-top: .75rem; padding: 4px 16px 10px; border: 1px solid var(--borde); border-left: 4px solid var(--elaborado); background: var(--elaborado-fondo); border-radius: var(--r-s); overflow-x: auto; max-width: 100%; position: relative; }
  .resp::before { content: 'Respuesta elaborada para el sitio — no oficial'; display: block; margin: 6px 0 4px; font-size: .78rem; font-weight: 700; color: var(--elaborado); text-transform: uppercase; letter-spacing: .03em; }
  .resp table { display: block; overflow-x: auto; border-collapse: collapse; max-width: 100%; }
  .resp th, .resp td { border: 1px solid var(--borde-fuerte); padding: 5px 9px; vertical-align: top; }
  .resp img { max-width: 100%; height: auto; }
  .preg-acc { display: flex; flex-wrap: wrap; gap: 8px; margin-top: .6rem; }
  .preg-acc button { min-height: 44px; padding: 6px 16px; }
  .preg-acc button[aria-pressed='true'].btn-sabe { background: var(--e-ok-bg); color: var(--e-ok); border-color: var(--e-ok); }
  .preg-acc button[aria-pressed='true'].btn-dudosa { background: var(--generado-fondo); color: var(--generado); border-color: var(--generado); }
  .preg-acc button[aria-pressed='true'].btn-nose { color: var(--pendiente); border-color: var(--pendiente); }
  .preg-acc button:focus-visible, .preg-resp > summary:focus-visible { outline: 3px solid var(--link); outline-offset: 2px; }
  @media (max-width: 520px) { .preg { padding: 14px 14px 12px; } .resp { padding: 4px 10px 8px; } }
</style>
