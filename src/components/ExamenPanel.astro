---
// Panel del modo examen (lógica en scripts/examen.js). Empieza hidden: sin JS no estorba y se ve todo.
const { id, minutos = 120 } = Astro.props;
---
<section class="tarjeta examen-panel" data-examen-panel data-examen-id={id} hidden aria-labelledby="ex-t">
  <h2 id="ex-t" tabindex="-1">Modo examen</h2>
  <p class="meta" data-en="reposo"><span data-ex="ultimo"></span> Solo enunciados, con cronómetro; al entregar se revelan las soluciones y te autocorregís.</p>
  <div class="ex-fila">
    <button type="button" data-ex="abrir" data-en="reposo">Rendir como examen</button>
    <label data-en="listo">Minutos <input type="number" data-ex="minutos" value={minutos} min="1" max="600" inputmode="numeric" /></label>
    <button type="button" data-ex="empezar" data-en="listo">Empezar</button>
    <output class="ex-reloj" data-ex="reloj" data-en="corriendo" role="timer" aria-label="Tiempo restante"></output>
    <button type="button" data-ex="pausa" data-en="corriendo">Pausar</button>
    <button type="button" data-ex="entregar" data-en="corriendo">Entregar</button>
    <button type="button" class="ex-salir" data-ex="salir" data-en="listo corriendo entregado">Salir del modo examen</button>
  </div>
  <p class="ex-conf" data-ex="conf" role="alertdialog" aria-label="Confirmar salida" hidden>¿Salir sin entregar? Se pierde este intento.
    <button type="button" data-ex="conf-si">Sí, salir</button>
    <button type="button" data-ex="conf-no">No, seguir</button>
  </p>
  <p class="ex-aviso" data-ex="aviso" role="alert" hidden>Se terminó el tiempo. Podés seguir, pero ya pasó el límite.</p>
  <div data-en="entregado" aria-live="polite">
    <p class="ex-nota">Nota estimada: <strong data-ex="nota"></strong>/100 · Tiempo usado: <span data-ex="usado"></span></p>
    <p class="meta" data-ex="detalle"></p>
    <p class="meta">Estimación de estudio: Bien cuenta 100 %, A medias 50 %, Mal 0 %, con el mismo peso por ejercicio.</p>
  </div>
</section>
