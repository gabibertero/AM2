---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import InstanciaSec from '../../components/InstanciaSec.astro';
import { INSTANCIAS, instanciaDeUnidad } from '../../lib/sitio.js';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('teoria')).sort((a, b) => a.data.orden - b.data.orden);
---
<Layout titulo="Teoría">
  <h1>Teoría por unidad</h1>
  <p class="lead">Contenido elaborado para el sitio a partir de los apuntes; no es material oficial. Cada unidad indica su alcance y su estado.</p>
  <p><a class="btn btn-primario" href={`${base}preguntero/`}>Practicá con el preguntero teórico</a></p>
  {INSTANCIAS.map(({ i: inst }) => { const lista = items.filter((x) => instanciaDeUnidad(x.data.unidad) === inst); return (
  <InstanciaSec i={inst} vacio={!lista.length}>
  <ul class="grilla lista-tarjetas llena">
    {lista.map((i) => (
      <li class="tarjeta tarjeta-u" data-unidad={i.data.unidad}>
        <a class="ec-titulo" href={`${base}teoria/${i.id}/`}><span class="chip chip-u chip-lg" data-unidad={i.data.unidad}>{i.data.unidad}</span><span class="ec-t">{i.data.titulo}</span></a>
        <p class="meta">
          <span class="insignia" data-estado={i.data.estado}>{i.data.estado}</span>
          <span class="insignia" data-alcance={i.data.alcance}>alcance {i.data.alcance}</span>
        </p>
      </li>
    ))}
  </ul>
  </InstanciaSec>
  ); })}
</Layout>
