---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const todos = (await getCollection('teoria')).sort((a, b) => a.data.orden - b.data.orden);
  return todos.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, anterior: todos[i - 1], siguiente: todos[i + 1] },
  }));
}
const { entry, anterior, siguiente } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const d = entry.data;
---
<Layout titulo={`${d.unidad} · ${d.titulo}`}>
  <p class="meta"><a href={`${base}teoria/`}>← Teoría</a></p>
  <h1>{d.unidad} · {d.titulo}</h1>
  <p class="meta">
    <span class="insignia" data-estado={d.estado}>{d.estado}</span>
    <span class="insignia" data-alcance={d.alcance}>alcance {d.alcance}</span>
  </p>
  <div class="capa elaborado teoria">
    <p class="rotulo">Teoría · Elaborado para el sitio — no oficial</p>
    <Content />
    <h2>Fuentes de la unidad</h2>
    <ul>{d.fuentes.map((f) => <li>{f}</li>)}</ul>
  </div>
  <p class="meta">
    {anterior && <a href={`${base}teoria/${anterior.id}/`}>← {anterior.data.unidad}</a>}
    {anterior && siguiente && ' · '}
    {siguiente && <a href={`${base}teoria/${siguiente.id}/`}>{siguiente.data.unidad} →</a>}
  </p>
</Layout>
<style is:global>
  .insignia { display: inline-block; border: 1px solid var(--borde); border-radius: 999px; padding: 0 10px; margin-right: 6px; font-size: .8rem; font-weight: 600; background: var(--panel); }
  .insignia[data-estado='borrador'] { border-color: var(--generado); color: var(--generado); }
  .insignia[data-alcance='tentativo'], .insignia[data-alcance='sin material'] { border-color: var(--pendiente); color: var(--pendiente); }
  .teoria h2 { margin-top: 2.2rem; border-top: 2px solid var(--borde); padding-top: .8rem; }
  .teoria h3 { margin-top: 1.6rem; }
</style>
