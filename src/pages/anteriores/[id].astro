---
import { getCollection, render } from 'astro:content';
import { idsDeEjercicios } from '../../scripts/ids.js';
import ExamenPanel from '../../components/ExamenPanel.astro';
import Layout from '../../layouts/Layout.astro';
import { limpiarFuente } from '../../lib/fuente.js';

export async function getStaticPaths() {
  const todos = (await getCollection('anteriores')).sort((a, b) => a.data.orden - b.data.orden);
  return todos.map((entry) => ({ params: { id: entry.id }, props: { entry, todos } }));
}
const { entry, todos } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const d = entry.data;
---
<Layout titulo={d.titulo}>
  <ul class="tabs" aria-label="Exámenes">
    {todos.map((t) => (
      <li><a href={`${base}anteriores/${t.id}/`} aria-current={t.id === entry.id ? 'page' : undefined}>{t.data.titulo.match(/Examen \w · Tema \d/)?.[0]}</a></li>
    ))}
  </ul>
  <div class="examen-cab tarjeta">
    <h1>{d.titulo}</h1>
    <p class="meta">{d.fecha ?? 'sin fecha'} · {d.tipo} · Tema {d.tema} · Unidades: {d.unidades.map((u) => <span class="chip chip-u" data-unidad={u}>{u}</span>)}</p>
    <p class="meta">Fuente: {limpiarFuente(d.fuente.split('/').pop())} (foto de clase; sin resolución oficial)</p>
    <span class="barra" aria-hidden="true" data-barra data-ids={idsDeEjercicios(entry.body).join(',')}></span>
  </div>
  <ExamenPanel id={entry.id} />
  <div class="examen-grid">
    <nav class="indice" aria-label="Ejercicios del examen" data-indice><p class="indice-t">Ejercicios</p><ol></ol></nav>
    <div class="examen-cont"><Content /></div>
  </div>
</Layout>
