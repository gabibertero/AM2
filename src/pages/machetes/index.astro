---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { UNIDADES_MACHETES } from '../../unidades-machetes';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('machetes')).sort((a, b) => a.data.orden - b.data.orden);
const unidades = UNIDADES_MACHETES;
---
<Layout titulo="Machetes">
  <h1>Machetes</h1>
  <p class="lead">Guías de bolsillo por tipo de problema. Contenido elaborado para el sitio, no oficial.</p>
  {unidades.map((u) => (
    <section class="unidad-sec" data-unidad={u}>
      <h2><span class="chip chip-u chip-lg" data-unidad={u}>{u}</span></h2>
      <ul class="grilla lista-tarjetas">
        {items.filter((i) => i.data.unidad === u).map((i) => (
          <li class="tarjeta tarjeta-u" data-unidad={u}><a class="ec-titulo" href={`${base}machetes/${i.data.slug}/`}>{i.data.titulo}</a></li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
