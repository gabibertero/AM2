---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeMapa from '../components/HomeMapa.astro';
import { getCollection } from 'astro:content';
import { idsDeEjercicios } from '../scripts/ids.js';
import { FECHA_PARCIAL } from '../lib/sitio.js';
const base = import.meta.env.BASE_URL;
const parciales = await getCollection('parciales');
const cuerpos = [...parciales, ...(await getCollection('anteriores'))];
const todosIds = cuerpos.flatMap((e) => idsDeEjercicios(e.body));
const nPracticos = parciales.filter((p) => p.data.tipo !== 'teórico').length;

// Temas que aparecieron en los parciales oficiales, por unidad (los 3 más frecuentes).
const cuenta = {};
for (const p of parciales) {
  for (const m of p.body.matchAll(/<Ejercicio\b[^>]*?unidad="(U\d+)"[^>]*?tema="([^"]+)"/g)) {
    const o = (cuenta[m[1]] ??= {});
    o[m[2]] = (o[m[2]] ?? 0) + 1;
  }
}
const temas = Object.fromEntries(Object.entries(cuenta).map(([u, o]) => [u, Object.entries(o).sort((a, b) => b[1] - a[1]).slice(0, 3)]));

const accesos = [
  ['📝', 'Parciales oficiales', `${nPracticos} resueltos`, 'parciales/'],
  ['⏱️', 'Rendir como examen', 'Con reloj y nota', 'parciales/'],
  ['❓', 'Preguntero', 'Teoría por unidad', 'preguntero/'],
  ['🎲', 'Simulacro teórico', '2 temas + 4 cortas + 3 choice', 'preguntero/simulacro/'],
  ['⚡', 'Machetes', 'Guías por tipo de problema', 'machetes/'],
  ['🗂️', 'Años anteriores', 'Fotos de clase', 'anteriores/'],
];
---
<Layout titulo="Inicio">
  <section class="hero">
    <div class="hero-txt">
      <p class="eyebrow">UTN FRC · Ingeniería en Sistemas</p>
      <h1>Análisis Matemático II</h1>
      <p class="lead">Preparate para el 2º parcial con exámenes reales, ejercicio por ejercicio, con pistas de a poco y sin spoilers.</p>
      <p class="hero-acc">
        <a class="btn btn-primario" href={`${base}parciales/`}>Empezar a practicar</a>
        <a class="btn" href={`${base}machetes/`}>Ver machetes</a>
      </p>
    </div>
    <HomeHero />
  </section>

  <section class="estado-home" aria-label="Tu estado">
    <div class="tarjeta" data-cuenta data-fecha={FECHA_PARCIAL ?? ''}>
      <strong>2º parcial</strong>
      {FECHA_PARCIAL === null ? (
        <p class="big-txt">Fecha a confirmar</p>
      ) : (
        <p class="big-txt"><b class="num" data-dias>{FECHA_PARCIAL}</b> <span class="suave" data-dias-txt></span></p>
      )}
    </div>
    <div class="tarjeta" data-tu-progreso data-ids={todosIds.join(',')}>
      <strong>Tu progreso</strong>
      <p class="big-txt"><b class="num" data-n>0</b> <span class="suave">de <span data-t>{todosIds.length}</span> ejercicios</span></p>
      <span class="barra" aria-hidden="true" data-barra data-ids={todosIds.join(',')}></span>
    </div>
    <div class="tarjeta">
      <strong>Seguir donde dejaste</strong>
      <p class="suave" data-seguir-vacio>Cuando empieces un ejercicio, lo retomás desde acá.</p>
      <a class="btn btn-primario" data-seguir hidden href={base}><span data-seguir-t></span>&nbsp;→</a>
    </div>
  </section>

  <h2>Accesos</h2>
  <div class="grilla accesos">
    {accesos.map(([emo, t, d, href]) => (
      <a class="tarjeta tarjeta-link" href={`${base}${href}`}>
        <span class="emo" aria-hidden="true">{emo}</span>
        <strong>{t}</strong>
        <span class="suave">{d}</span>
      </a>
    ))}
  </div>

  <h2>Mapa de la materia</h2>
  <p class="suave sec-nota">Unidades U4 a U10 (programa 2025; Fourier queda fuera). Los números cuentan cuántas veces apareció cada tema en los parciales prácticos.</p>
  <HomeMapa temas={temas} />

  <h2>Cómo distinguir lo oficial de lo demás</h2>
  <div class="leyenda">
    <div class="capa oficial"><p class="rotulo">Oficial</p>Enunciados tal cual el examen y resolución del profe (escaneo). Acento azul.</div>
    <div class="capa elaborado"><p class="rotulo">Elaborado para el sitio — no oficial</p>Pistas, pasos, soluciones y comprobaciones escritas para estudiar. Acento verde.</div>
    <div class="capa generado"><p class="rotulo">Simulacro generado — no oficial</p>Ejercicios inventados por el sitio. Borde punteado ámbar.</div>
  </div>

  <h2>Dónde se guarda tu progreso</h2>
  <p>
    En tu navegador (localStorage), con claves que empiezan con <code>am2:v1:</code>. No hay cuentas ni servidor: no se comparte entre dispositivos
    y se pierde si borrás los datos del navegador. Actualizar el sitio no lo borra.
  </p>
  <button type="button" data-reiniciar>Reiniciar progreso</button>
  <div class="capa generado" data-confirmar hidden role="group" aria-label="Confirmar reinicio">
    <p><strong>¿Seguro?</strong> Se borran los estados y las ayudas reveladas de todos los ejercicios. No se puede deshacer.</p>
    <button type="button" data-si>Sí, borrar todo</button>
    <button type="button" data-no>Cancelar</button>
  </div>
  <p role="status" tabindex="-1" data-resultado></p>
  <script>
    import '../scripts/home.js';
  </script>
</Layout>
