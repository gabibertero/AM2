---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { esP2, ordenarParciales, TIPOS, DIAS } from '../lib/preparacion.js';
import { idsDeEjercicios } from '../scripts/ids.js';
const base=import.meta.env.BASE_URL;
const examenes=(await getCollection('parciales')).filter(esP2).sort(ordenarParciales);
const primero=examenes[0];
const ids=examenes.flatMap(e=>idsDeEjercicios(e.body));
const recursos = {
 hoy: [null, ['parciales/1h10-2026-10-31-a/#ej-5', 'Abrir ejercicio 5'], null, ['parciales/1h10-2026-10-31-a/#ej-1', 'Abrir ejercicio 1'], ['errores/', 'Anotar qué necesito repetir']],
 jueves: [['parciales/1h10-2026-10-31-a/#ej-3', 'Abrir ejercicio 3'], ['parciales/1h10-2026-10-31-a/#ej-4', 'Abrir ejercicio 4'], ['parciales/1h10-2026-10-31-a/', 'Volver al parcial de tu curso'], ['parciales/1h9-2026-06-27-a/', 'Seguir con junio de 2026'], ['parciales/', 'Ver la ruta completa']],
 viernes: [['parciales/', 'Elegir el próximo parcial'], ['errores/', 'Ver mis dificultades'], ['machetes/', 'Buscar mi método'], ['parciales/', 'Continuar la ruta']],
};
---
<Layout titulo="Hoy · Prepará tu práctico">
 <section class="saludo"><p class="eyebrow">TU PLAN PARA EL SÁBADO</p><h1>Un ejercicio a la vez.<br /><span>Vos podés empezar de cero.</span></h1><p class="lead">Parciales reales de tu curso, explicados en pasos cortos.<br />Primero entendé cómo se hace. Después, probá sin mirar.</p></section>
 <div class="lab-acceso"><p><strong>Ahora podés resolver y comprobar.</strong><br />Un paso a la vez, sobre los parciales que ya tenés cargados.</p><a class="btn btn-primario" href={`${base}laboratorio/?parcial=1h10-2026-10-31-a&ejercicio=5`}>Entrar al laboratorio →</a></div>
 <div class="dashboard">
  <div class="dashboard-main">
   <section class="empezar-card">
    <div class="empezar-top"><span class="pill"><span class="status-dot"></span> EMPEZÁ POR ACÁ</span><span class="mini">TU CURSO · 31 OCT 2026</span></div>
    <h2>El parcial del sábado pasado.</h2><p>Los 5 ejercicios que tomó Mazzuchelli en tu curso.<br />Elegí uno y abrí el machete si no sabés cómo arrancar.</p>
    <div class="mini-temas"><span>Volumen</span><span>Triple</span><span>Curvilínea</span><span>EDO 1</span><span>EDO 2</span></div>
    <div class="empezar-bottom"><a class="btn btn-primario" href={`${base}parciales/${primero.id}/`}>Empezar este parcial <span aria-hidden="true">↗</span></a><span class="mini">5 ejercicios · con guía desde cero</span></div>
   </section>
   <section class="plan-diario" aria-labelledby="plan-t"><div class="section-title"><h2 id="plan-t">Tu recorrido hasta el sábado</h2><span class="mini">Papel y lápiz, a tu ritmo</span></div>
    <div class="day-tabs" role="group" aria-label="Elegir día del plan">{DIAS.map((d,i)=><button type="button" data-dia={d.id} aria-pressed={i===0}>{d.dia}<small>{d.tiempo}</small></button>)}</div>
    {DIAS.map((d,i)=><div data-plan-dia={d.id} hidden={i!==0}><h3>{d.titulo}</h3><ol class="plan-pasos">{d.pasos.map(([tiempo,titulo,detalle],j)=><li><span class="paso-bullet">{String(j+1).padStart(2,'0')}</span><div><strong>{titulo}</strong><p>{detalle}</p>{recursos[d.id]?.[j] && <a class="plan-recurso" href={`${base}${recursos[d.id][j][0]}`}>{recursos[d.id][j][1]} →</a>}</div><span class="tiempo">{tiempo}</span></li>)}</ol></div>)}
   </section>
   <section><div class="section-title"><h2>¿Cómo se resuelve cada tipo?</h2><a href={`${base}machetes/`}>Todos los machetes ↗</a></div><div class="tipos-grid">{TIPOS.map(t=><a class={`tipo-card ${t.color}`} href={`${base}machetes/${t.slug}/`}><span class="tipo-num">{t.n}</span><div><h3>{t.titulo}</h3><p>{t.pista}</p></div><span aria-hidden="true">↗</span></a>)}</div></section>
  </div>
  <aside class="dashboard-aside">
   <section class="objetivo-card"><p class="eyebrow">EL OBJETIVO</p><div class="fecha-grande"><b>07</b><span>NOVIEMBRE<br />SÁBADO · 2026</span></div><div class="objetivo-datos"><p><strong>2 horas</strong><span>para resolver</span></p><p><strong>4–5</strong><span>ejercicios</span></p></div><p class="nota-pequena">En el parcial del 31/10 pidieron desarrollo y cálculos auxiliares, sin calculadora ni tablas.</p></section>
   <section class="progreso-card" data-tu-progreso data-ids={ids.join(',')}><p class="eyebrow">TU AVANCE EN LOS PARCIALES</p><p class="numero-progreso"><b data-n>0</b><span> / <span data-t>{ids.length}</span></span></p><span class="barra" data-barra data-ids={ids.join(',')}></span><p class="nota-pequena">Ejercicios marcados como resueltos. En «Mis errores» podés separar los que hiciste con ayuda.</p><a href={`${base}errores/`}>Ver qué necesito repetir ↗</a></section>
   <section class="retomar-card"><span class="eyebrow">DONDE TE QUEDASTE</span><p data-seguir-vacio>Todavía no empezaste. Tu último ejercicio aparecerá acá.</p><a data-seguir hidden href={base}><span data-seguir-t></span> →</a></section>
   <section class="consejo-card"><span aria-hidden="true">✳</span><h3>No hace falta saberlo antes.</h3><p>Abrí «Siguiente paso», entendé una sola operación y hacela en tu hoja. Después seguí con la próxima.</p></section>
  </aside>
 </div>
 <script>import '../scripts/home.js';</script>
</Layout>
