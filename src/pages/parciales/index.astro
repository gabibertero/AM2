---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { idsDeEjercicios } from '../../scripts/ids.js';
const base = import.meta.env.BASE_URL;
const examenes = (await getCollection('parciales')).sort((a, b) => a.data.orden - b.data.orden);
---
<Layout titulo="Parciales oficiales">
  <h1>Parciales oficiales</h1>
  <p class="lead">Exámenes reales de 2025–2026, con sus ejercicios en el orden original.</p>
  <ul class="grilla lista-tarjetas">
    {examenes.map((e) => (
      <li class="tarjeta examen-card">
        <div class="ec-top">
          <span class="chip chip-fuerte">{e.data.comision}</span>
          {e.body.includes('<Solucion') && <span class="chip chip-ok">✔ Con solución</span>}
        </div>
        <a class="ec-titulo" href={`${base}parciales/${e.id}/`}>{e.data.titulo}</a>
        <p class="meta">{e.data.fecha} · {e.data.tipo}</p>
        <p class="chips">{e.data.unidades.map((u) => <span class="chip chip-u" data-unidad={u}>{u}</span>)}</p>
        <span class="barra" aria-hidden="true" data-barra data-ids={idsDeEjercicios(e.body).join(',')}></span>
        <span class="progreso" data-progreso data-ids={idsDeEjercicios(e.body).join(',')}></span>
      </li>
    ))}
  </ul>
  <p class="meta">¿Buscás más práctica? Mirá los <a href={`${base}anteriores/`}>exámenes de años anteriores</a>.</p>
</Layout>
