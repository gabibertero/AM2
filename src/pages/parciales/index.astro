---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { idsDeEjercicios } from '../../scripts/ids.js';
import { esP2, ordenarParciales } from '../../lib/preparacion.js';
const base=import.meta.env.BASE_URL;
const examenes=(await getCollection('parciales')).filter(esP2).sort(ordenarParciales);
---
<Layout titulo="Parciales oficiales">
<p class="eyebrow">LA RUTA DE PRÁCTICA</p><h1>Del más reciente<br /><span class="titulo-suave">al próximo que vas a dominar.</span></h1><p class="lead">Empezá por el del 31/10 de tu curso. Después seguí hacia atrás.<br />En cada parcial podés aprender con ayuda o simular 2 horas de examen.</p>
<div class="info-strip"><strong>{examenes.length} parciales prácticos</strong><span>Ordenados por fecha real · temas A/B separados</span></div>
<ol class="exam-list">{examenes.map((e,i)=><li class:list={['exam-row',{'reciente':i===0}]}><span class="exam-orden">{String(i+1).padStart(2,'0')}</span><div class="exam-info"><div class="exam-meta">{e.data.fecha} <span>· {e.data.comision}{e.data.tema?` · ${e.data.tema}`:''}</span>{i===0&&<span class="pill pill-curso">TU CURSO</span>}</div><h2><a href={`${base}parciales/${e.id}/`}>{e.data.titulo}</a></h2><p>{idsDeEjercicios(e.body).length} ejercicios · {e.data.tipo==='recuperatorio'?'Recuperatorio':'Parcial práctico'}</p></div><div class="exam-avance"><span data-progreso data-ids={idsDeEjercicios(e.body).join(',')}></span><span class="barra" data-barra data-ids={idsDeEjercicios(e.body).join(',')}></span></div><a class="exam-abrir" href={`${base}parciales/${e.id}/`} aria-label={`Abrir ${e.data.titulo}`}><span aria-hidden="true">↗</span></a></li>)}</ol>
</Layout>
