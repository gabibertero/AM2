---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import InstanciaSec from '../../components/InstanciaSec.astro';
import { idsDeEjercicios } from '../../scripts/ids.js';
import { INSTANCIAS, instanciaDeUnidades } from '../../lib/sitio.js';
const corto = (v, alt) => (/^no figura/i.test(v) ? alt : v);
const base = import.meta.env.BASE_URL;
const examenes = (await getCollection('parciales')).sort((a, b) => a.data.orden - b.data.orden);
---
<Layout titulo="Parciales oficiales">
  <h1>Parciales oficiales</h1>
  <p class="lead">Exámenes reales de 2025–2026, separados por instancia, con sus ejercicios en el orden original.</p>
  {INSTANCIAS.map(({ i }) => { const lista = examenes.filter((e) => instanciaDeUnidades(e.data.unidades) === i); return (
  <InstanciaSec i={i} vacio={!lista.length}>
  <ul class="grilla lista-tarjetas">
    {lista.map((e) => (
      <li class="tarjeta examen-card">
        <div class="ec-top">
          <span class="chip chip-fuerte">{corto(e.data.comision, 'sin comisión')}{e.data.tema && ` · Tema ${e.data.tema}`}</span>
          {e.body.includes('<Solucion') && <span class="chip chip-ok">✔ Con solución</span>}
        </div>
        <a class="ec-titulo" href={`${base}parciales/${e.id}/`}>{e.data.titulo}</a>
        <p class="meta">{corto(e.data.fecha, 'sin fecha')} · {e.data.tipo}</p>
        <p class="chips">{e.data.unidades.map((u) => <span class="chip chip-u" data-unidad={u}>{u}</span>)}</p>
        <span class="barra" aria-hidden="true" data-barra data-ids={idsDeEjercicios(e.body).join(',')}></span>
        <span class="progreso" data-progreso data-ids={idsDeEjercicios(e.body).join(',')}></span>
      </li>
    ))}
  </ul>
  </InstanciaSec>
  ); })}
  <p class="meta">¿Buscás más práctica? Mirá los <a href={`${base}anteriores/`}>exámenes de años anteriores</a>.</p>
</Layout>
